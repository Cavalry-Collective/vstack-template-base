{
  "permissions": {
    "ask": [
      "Bash(terraform apply)",
      "Bash(terraform apply:*)",
      "Bash(prisma migrate reset)",
      "Bash(prisma migrate reset:*)",
      "Bash(git push)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-applied-migration-edits.sh"
          }
        ]
      }
    ]
  }
}
